{
  "trigger": "talk",
  "presentation": {
    "mode": "ask",
    "prompt": "dialogue.main.chat",
    "resume_prompt": "dialogue_event.mca.social.chat.resume",
    "topic": "small_talk"
  },
  "priority": 0,
  "weight": 1,
  "repeat": {
    "type": "cooldown",
    "seconds": 5
  },
  "history": "scheduling",
  "start": "prompt",
  "nodes": {
    "prompt": {
      "line": "dialogue_event.mca.social.chat.opening",
      "choices": [
        { "id": "day", "text": "dialogue_event.mca.social.chat.choice.day", "next": "day_reaction" },
        { "id": "village", "text": "dialogue_event.mca.social.chat.choice.village", "next": "reaction" },
        { "id": "news", "text": "dialogue_event.mca.social.chat.choice.news", "next": "news_reaction" }
      ]
    },
    "day_reaction": {
      "outcomes": [
        { "weight": 5, "actions": [{ "type": "mca:hearts", "amount": 5 }], "next": "day_success" },
        { "requirements": [{ "type": "mca:personality", "value": "gloomy" }], "weight": 4, "actions": [{ "type": "mca:hearts", "amount": 5 }], "next": "day_success" },
        { "requirements": [{ "type": "mca:personality", "value": "sensitive" }], "weight": 2, "actions": [{ "type": "mca:hearts", "amount": 5 }], "next": "day_success" },
        { "weight": 1, "fatigue": 1.0, "next": "day_fail" },
        { "requirements": [{ "type": "mca:personality", "value": "odd" }], "weight": 5, "next": "day_fail" },
        { "requirements": [{ "type": "mca:personality", "value": "flirty" }], "weight": 1, "next": "day_fail" }
      ]
    },
    "news_reaction": {
      "outcomes": [
        { "weight": 5, "actions": [{ "type": "mca:hearts", "amount": 5 }], "next": "news_success" },
        { "requirements": [{ "type": "mca:personality", "value": "gloomy" }], "weight": 4, "actions": [{ "type": "mca:hearts", "amount": 5 }], "next": "news_success" },
        { "requirements": [{ "type": "mca:personality", "value": "sensitive" }], "weight": 2, "actions": [{ "type": "mca:hearts", "amount": 5 }], "next": "news_success" },
        { "weight": 1, "fatigue": 1.0, "next": "news_fail" },
        { "requirements": [{ "type": "mca:personality", "value": "odd" }], "weight": 5, "next": "news_fail" },
        { "requirements": [{ "type": "mca:personality", "value": "flirty" }], "weight": 1, "next": "news_fail" }
      ]
    },
    "reaction": {
      "outcomes": [
        {
          "weight": 5,
          "actions": [
            { "type": "mca:hearts", "amount": 5 }
          ],
          "next": "success"
        },
        {
          "requirements": [
            { "type": "mca:personality", "value": "gloomy" }
          ],
          "weight": 4,
          "actions": [
            { "type": "mca:hearts", "amount": 5 }
          ],
          "next": "success"
        },
        {
          "requirements": [
            { "type": "mca:personality", "value": "sensitive" }
          ],
          "weight": 2,
          "actions": [
            { "type": "mca:hearts", "amount": 5 }
          ],
          "next": "success"
        },
        {
          "weight": 1,
          "fatigue": 1.0,
          "next": "fail"
        },
        {
          "requirements": [
            { "type": "mca:personality", "value": "odd" }
          ],
          "weight": 5,
          "next": "fail"
        },
        {
          "requirements": [
            { "type": "mca:personality", "value": "flirty" }
          ],
          "weight": 1,
          "next": "fail"
        }
      ]
    },
    "success": {
      "line": "dialogue_event.mca.social.chat.village.success",
      "next": "village_followup"
    },
    "fail": {
      "line": "dialogue_event.mca.social.chat.village.fail",
      "next": "village_doubt_followup"
    },
    "day_success": {
      "line": "dialogue_event.mca.social.chat.day.success",
      "next": "day_followup"
    },
    "day_fail": {
      "line": "dialogue_event.mca.social.chat.day.fail",
      "complete": true
    },
    "news_success": {
      "line": "dialogue_event.mca.social.chat.news.success",
      "next": "news_followup"
    },
    "news_fail": {
      "line": "dialogue_event.mca.social.chat.news.fail",
      "complete": true
    },
    "day_followup": {
      "line": "dialogue_event.mca.social.chat.followup.day",
      "choices": [
        { "id": "day_busy", "text": "dialogue_event.mca.social.chat.choice.day_busy", "next": "day_busy_reply" },
        { "id": "day_rest", "text": "dialogue_event.mca.social.chat.choice.day_rest", "next": "day_rest_reply" },
        { "id": "day_leave", "text": "dialogue_event.mca.social.chat.choice.day_leave", "next": "day_leave_reply" }
      ]
    },
    "village_followup": {
