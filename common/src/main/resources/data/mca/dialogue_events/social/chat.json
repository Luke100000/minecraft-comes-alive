      "choices": [
        { "id": "village_encourage", "text": "dialogue_event.mca.social.chat.choice.village_encourage", "next": "village_encourage_reply" },
        { "id": "village_understand", "text": "dialogue_event.mca.social.chat.choice.village_understand", "next": "village_understand_reply" }
      ]
    },
    "news_followup": {
      "line": "dialogue_event.mca.social.chat.followup.news",
      "choices": [
        { "id": "news_share", "text": "dialogue_event.mca.social.chat.choice.news_share", "next": "news_share_reply" },
        { "id": "news_wait", "text": "dialogue_event.mca.social.chat.choice.news_wait", "next": "news_wait_reply" }
      ]
    },
    "day_busy_reply": {
      "line": "dialogue_event.mca.social.chat.reply.day_busy",
      "complete": true
    },
    "day_rest_reply": {
      "line": "dialogue_event.mca.social.chat.reply.day_rest",
      "complete": true
    },
    "day_leave_reply": {
      "line": "dialogue_event.mca.social.chat.reply.day_leave",
      "complete": true
    },
    "village_friendly_reply": {
      "line": "dialogue_event.mca.social.chat.reply.village_friendly",
      "complete": true
    },
    "village_new_reply": {
      "line": "dialogue_event.mca.social.chat.reply.village_new",
      "complete": true
