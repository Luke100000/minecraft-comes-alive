  },
  "history": "scheduling",
  "start": "confirm",
  "nodes": {
    "confirm": {
      "line": "dialogue.adopt",
      "silent": true,
      "choices": [
        {
          "id": "confirm",
          "text": "dialogue.adopt.confirm",
          "actions": [
            { "type": "mca:command", "command": "adopt" }
          ],
          "next": "accepted"
        },
        {
          "id": "cancel",
          "text": "dialogue.adopt.cancel",
          "next": "cancelled"
        }
      ]
    },
    "accepted": {
      "line": "dialogue.adopt.confirm",
      "silent": true,
      "complete": true
    },
    "cancelled": {
      "line": "dialogue.adopt.cancel",
      "silent": true,
      "complete": true
    }
  }
