{
  "trigger": "talk",
  "presentation": {
    "mode": "ask",
    "prompt": "dialogue.main.adopt",
    "resume_prompt": "dialogue_event.mca.relationship.adopt.resume",
    "topic": "relationship"
  },
  "priority": 0,
  "weight": 1,
  "requirements": [
    { "type": "mca:family", "value": "orphan" },
    {
      "type": "mca:not",
      "condition": { "type": "mca:age_group", "value": "adult" }
    }
  ],
  "repeat": {
    "type": "cooldown",
